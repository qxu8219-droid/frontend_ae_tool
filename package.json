{
  "name": "robot-log-replay-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "3.5.44",
    "pinia": "3.0.4",
    "naive-ui": "2.45.3",
    "echarts": "5.6.0",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@types/node": "22.20.5",
    "@playwright/test": "1.58.2",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.13"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
