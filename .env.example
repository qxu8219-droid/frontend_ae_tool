# The public demo uses synthetic data. Override false for the real API; no fallback.
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api/v1

# Real mode only; Mock remains fixed at 1 MiB. Server validation is authoritative.
VITE_MAX_UPLOAD_BYTES=67108864

# Vite reads VITE_* at startup/build; restart/rebuild after changing mode.
# The dev proxy reads the shell environment, e.g.:
# API_PROXY_TARGET=http://127.0.0.1:8000 VITE_USE_MOCK=false npm run dev
