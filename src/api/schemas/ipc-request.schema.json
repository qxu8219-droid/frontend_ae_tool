  "properties": {
    "command": {
      "discriminator": {
        "mapping": {
          "apply_keyframe": "#/$defs/ApplyKeyframe",
          "heartbeat": "#/$defs/Heartbeat",
          "load_log": "#/$defs/LoadLog",
          "load_robot": "#/$defs/LoadRobot",
          "load_scene": "#/$defs/LoadScene",
          "pause_barrier": "#/$defs/PauseBarrier",
          "reset": "#/$defs/Reset",
          "shutdown": "#/$defs/Shutdown",
          "subscribe_ready": "#/$defs/SubscribeReady"
        },
        "propertyName": "cmd"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LoadScene"
        },
        {
          "$ref": "#/$defs/LoadRobot"
        },
        {
          "$ref": "#/$defs/LoadLog"
        },
        {
          "$ref": "#/$defs/ApplyKeyframe"
        },
        {
          "$ref": "#/$defs/PauseBarrier"
        },
        {
          "$ref": "#/$defs/Reset"
        },
        {
          "$ref": "#/$defs/Shutdown"
        },
        {
          "$ref": "#/$defs/Heartbeat"
        },
        {
          "$ref": "#/$defs/SubscribeReady"
        }
      ],
      "title": "Command"
    },
    "control_seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Control Seq",
      "type": "integer"
    },
    "playback_epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Playback Epoch",
      "type": "integer"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "request_id",
    "control_seq",
    "playback_epoch",
