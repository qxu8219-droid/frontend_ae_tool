          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Control Seq",
          "type": "integer"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "joint_efforts": {
          "default": null,
          "title": "Joint Efforts",
          "type": "null"
        },
        "joint_velocities": {
          "default": null,
          "title": "Joint Velocities",
          "type": "null"
        },
        "joints": {
          "items": {
            "type": "number"
          },
          "maxItems": 28,
          "minItems": 28,
          "title": "Joints",
          "type": "array"
        },
        "log_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Log Id",
          "type": "string"
