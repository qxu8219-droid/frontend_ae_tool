{
  "$defs": {
    "ApplyKeyframe": {
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "apply_keyframe",
          "title": "Cmd",
          "type": "string"
        },
        "frame": {
          "$ref": "#/$defs/TargetFrame"
        }
      },
      "required": [
        "cmd",
        "frame"
      ],
      "title": "ApplyKeyframe",
      "type": "object"
    },
    "ChannelQuality": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "origin": {
          "enum": [
            "measured",
            "commanded",
            "derived",
            "missing"
          ],
          "title": "Origin",
          "type": "string"
        },
        "processing": {
          "default": [],
          "items": {
            "enum": [
              "original",
              "unit_converted",
              "interpolated",
              "forward_filled",
              "defaulted",
              "derived"
            ],
            "type": "string"
          },
          "title": "Processing",
          "type": "array"
        },
        "source_indices": {
          "default": [],
          "items": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Source Indices",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "valid"
      ],
      "title": "ChannelQuality",
      "type": "object"
    },
    "ChassisPose": {
