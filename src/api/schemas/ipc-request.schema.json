          "type": "string"
        },
        "playback_epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Playback Epoch",
          "type": "integer"
        },
        "progress": {
          "maximum": 1,
          "minimum": 0,
