        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "source_sample_index": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sample Index"
        },
        "speed": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.1,
          "title": "Speed",
          "type": "number"
        },
        "state": {
          "default": "paused",
          "enum": [
            "ready",
            "playing",
            "paused",
            "ended"
          ],
          "title": "State",
          "type": "string"
        },
        "target_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Target Seq",
          "type": "integer"
        }
