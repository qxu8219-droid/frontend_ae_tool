          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "set_telemetry_rate",
          "title": "Type",
          "type": "string"
        },
        "wall_time": {
          "description": "UTC Unix seconds; system clock, not log time.",
          "minimum": 0,
          "title": "Wall Time",
          "type": "number"
        }
